{
  "name": "danni-bg",
  "version": "0.1.0",
  "description": "Synced local mirror of data.egov.bg with curation and machine-readable index.",
  "type": "module",
  "private": true,
  "license": "EUPL-1.2",
  "bin": {
    "danni": "./bin/danni"
  },
  "scripts": {
    "danni": "bun run src/cli/danni.ts",
    "db:migrate": "bun run src/store/migrate-cli.ts",
    "explorer:api": "bun run --hot apps/explorer-api/src/server.ts",
    "explorer:gen-geo": "bun run packages/geo-boundaries/scripts/generate-crosswalk.ts",
    "eval:agentic": "uv run --project eval/agentic pytest eval/agentic",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:e2e": "cd apps/explorer-web && bun run test:e2e",
    "coverage": "bun test --coverage --coverage-reporter=text --coverage-reporter=lcov",
    "typecheck": "tsc --noEmit",
    "prepare": "simple-git-hooks"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "simple-git-hooks": {
    "pre-commit": "bun run lint && bun run typecheck"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.81",
    "@ai-sdk/openai": "^3.0.68",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@ory/client": "^1.22.37",
    "ai": "^6.0.197",
    "d3-geo": "^3.1.1",
    "hono": "^4.12.23",
    "react-router-dom": "^7.18.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/react": "16.3.2",
    "@types/bun": "^1.3.0",
    "@types/d3-geo": "^3.1.0",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "happy-dom": "20.10.6",
    "lucide-react": "^1.17.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "simple-git-hooks": "^2.11.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.6.0",
    "vite": "^8.0.16",
    "zustand": "^5.0.14"
  }
}
