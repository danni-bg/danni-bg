# Copy to .env (gitignored; Bun auto-loads it for `bun run`).

# Chat default provider for the explorer API. Without these, /api/chat returns
# "no server default provider is configured". The chat agent uses tools, so the
# endpoint MUST support tool/function calling.
#
# Examples:
#   Self-hosted vLLM (openai-compatible), started with
#   --enable-auto-tool-choice --tool-call-parser:
EXPLORER_DEFAULT_PROVIDER=openai-compatible
EXPLORER_DEFAULT_MODEL=gemma-4-26b-uncensored
EXPLORER_DEFAULT_BASE_URL=http://spark:8000/v1
EXPLORER_DEFAULT_API_KEY=EMPTY
#
#   Anthropic:
# EXPLORER_DEFAULT_PROVIDER=anthropic
# EXPLORER_DEFAULT_MODEL=claude-sonnet-4-6
# EXPLORER_DEFAULT_API_KEY=sk-ant-...
#
# NOTE (spec 019): EXPLORER_DEFAULT_* is now a SEED. On first run the explorer API
# copies it into the platform_settings store; after that the admin settings UI is
# authoritative for the chat's default provider.

# --- Ory identity stack (spec 019; see infra/ory + docker-compose.yml) ---
# Kratos public/admin endpoints (used by the backend + the Vite dev proxy).
KRATOS_PUBLIC_URL=http://localhost:14433
KRATOS_ADMIN_URL=http://localhost:14434
# Oathkeeper access proxy fronting the gated /api/{chat,admin,auth} routes.
OATHKEEPER_PROXY_URL=http://localhost:14455
# Opt-in (spec 034): honor Oathkeeper's X-User-* identity headers. Set ONLY when a header-sanitizing
# Oathkeeper is the sole path to the app port — with the app exposed directly (single-port mode, the
# default) anyone could forge them. Off by default: identity then comes from the Kratos session
# cookie or an API key.
# TRUST_PROXY_AUTH_HEADERS=true
# Optional: comma-separated emails auto-promoted to admin on first login. Requires a VERIFIED email
# (spec 034); promotion is evaluated on first creation only, so verify before first login — a later
# verified login does not upgrade the row (use `danni admin grant <email>` instead).
# ADMIN_BOOTSTRAP_EMAILS=you@example.com

# --- Production deployment (spec 030; see docs/OPERATIONS.md + docker-compose.prod.yml) ---
# Profile gates the secret check: dev/development/test/local/ci allow the committed placeholders;
# any other value (e.g. production, staging) requires real, rotatable secrets below.
# DANNI_PROFILE=production
# Where the SQLite store lives in the container (mounted volume). Overrides danni.config.json's path.
# DANNI_STORE_ROOT=/data
# Real Ory secrets (NEVER the infra/ory/kratos.yaml placeholders). Generate, e.g.:
#   openssl rand -hex 16   # cookie (32+ chars)   /   openssl rand -hex 16   # cipher (exactly 32 chars)
# KRATOS_SECRETS_COOKIE=
# KRATOS_SECRETS_CIPHER=
# Strong Kratos Postgres password (replaces the dev `kratos`).
# POSTGRES_PASSWORD=
# Kratos courier SMTP relay (spec 037). REQUIRED in production: recovery/verification emails are
# account-takeover material, so the check-secrets gate rejects a missing value AND any
# Mailpit/localhost-shaped URI. In dev leave it unset — the compose default delivers to Mailpit
# (http://localhost:14438). Example: smtps://user:pass@smtp.relay.tld:465
# COURIER_SMTP_CONNECTION_URI=
